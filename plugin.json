{
  "manifestVersion": 2,
  "name": "vertex-ai-adapter",
  "displayName": "Vertex AI Adapter",
  "publisher": "mingli42",
  "version": "0.1.1",
  "description": "Use Gemini models on Google Vertex AI through CPR managed upstream adapters and ADC",
  "license": "MIT",
  "engines": { "codex-proxy-rs": ">=3.35.0, <4.0.0" },
  "main": "bin/plugin",
  "runtime": "trustedProcess",
  "contributes": {
    "upstream_adapter": { "version": 5, "inputFormats": ["openai"], "outputFormats": ["openai"] },
    "model_catalog": { "version": 2 }
  },
  "configurationSchema": {
    "type": "object",
    "required": ["projectId", "accountId", "models"],
    "properties": {
      "projectId": { "type": "string", "minLength": 6, "maxLength": 63 },
      "quotaProjectId": { "type": "string", "default": "", "maxLength": 63 },
      "location": { "type": "string", "default": "global", "minLength": 2, "maxLength": 64 },
      "accountId": { "type": "string", "minLength": 1, "maxLength": 128 },
      "models": {
        "type": "array", "minItems": 1, "maxItems": 32,
        "items": { "type": "string", "minLength": 3, "maxLength": 128 }
      }
    },
    "additionalProperties": false
  }
}
