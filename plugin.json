{
  "manifestVersion": 2,
  "name": "vertex-ai-adapter",
  "displayName": "Vertex AI Adapter",
  "publisher": "mingli42",
  "version": "0.2.0",
  "description": "Connect Google Cloud with gcloud ADC and use Gemini on Vertex AI through CPR",
  "license": "MIT",
  "engines": { "codex-proxy-rs": ">=3.38.2, <4.0.0" },
  "main": "bin/plugin",
  "runtime": "trustedProcess",
  "contributes": {
    "upstream_adapter": { "version": 5, "inputFormats": ["openai"], "outputFormats": ["openai"] },
    "model_catalog": { "version": 2 },
    "management": { "version": 2 }
  },
  "configurationSchema": {
    "type": "object",
    "properties": {
      "gcloudPath": { "type": "string", "default": "/app/.runtime/data/cpr-vertex-ai-adapter/google-cloud-sdk/bin/gcloud", "minLength": 1, "maxLength": 512 },
      "dataDir": { "type": "string", "default": "/app/.runtime/data/cpr-vertex-ai-adapter", "minLength": 1, "maxLength": 1024 }
    },
    "additionalProperties": false
  },
  "resources": {
    "web/index.html": "text/html",
    "web/app.js": "text/javascript",
    "web/app.css": "text/css"
  }
}
